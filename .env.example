# Copie para ".env" localmente. Na Vercel, configure estas mesmas variáveis
# em Project Settings → Environment Variables (nunca suba o ".env" pro Git).

# String de conexão do Postgres. Se usar Vercel Postgres (Storage → Create
# Database → Postgres no dashboard da Vercel), essa variável é preenchida
# automaticamente no projeto. Para desenvolvimento local, aponte para seu
# Postgres local ou para um banco de testes na nuvem (ex: Neon free tier).
POSTGRES_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Chave secreta usada para assinar as sessões de login (JWT). Gere uma
# aleatória forte, por exemplo com: openssl rand -base64 48
JWT_SECRET=

# Chave de API da Anthropic, usada pelas funcionalidades de IA do sistema.
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Usados apenas pelo script de seed (scripts/seed.js), na primeira vez que
# o banco é populado. Depois do primeiro login, troque a senha pelo próprio
# sistema.
SEED_ADMIN_EMAIL=steven.passos@actcon.com.br
SEED_ADMIN_SENHA=defina-uma-senha-forte-aqui
SEED_ADMIN_NOME=Steven Oliveira Passos
